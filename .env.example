# HandiHomepage Environment Variables
# Copy to .env and fill in your values
# .env is gitignored — never commit real secrets
#
# Load order (highest priority first): real environment variables, then
# HANDI_ENV_FILE (if set), then .env next to server.js, then a STABLE file one
# level above the versioned app dir — hbuilds/.env on the live host — so values
# survive the `hbuilds/current` symlink swaps that replace the app directory.

# Server port (default: 8080)
PORT=8080

# NTA GTFS-RT API key (bus tracker)
BUS_API_KEY=your_bus_api_key_here

# API-Sports key (sports module: fixtures, live scores, odds)
APISPORTS_KEY=your_apisports_key_here

# Infobip SMS API (emergency alerts)
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=api.infobip.com

# Stripe subscription (premium features)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Matrix bot username, read from .env at runtime and injected into the page
# as window.__CLIENT_ENV__.VITE_MATRIX_USER
VITE_MATRIX_USER=your_matrix_bot_username

# Matrix chat password (read from .env at runtime and injected into the page
# as window.__CLIENT_ENV__.VITE_MATRIX_PASS — treat as PUBLIC)
VITE_MATRIX_PASS=your_matrix_password_here

# Logging feature (user anonymised external data only)
LOG_USERNAME=your_http_auth_log_username_here
LOG_PASSWORD=your_http_auth_log_pass_here
# Log level: 2 = all events (default), 1 = important events/errors only,
# 0 = no client event logging. Use 1 (or 0) on busy production hosts.
LOG_LEVEL=2
# Log file size cap (bytes); when exceeded the file is trimmed to LOG_KEEP_BYTES
LOG_MAX_BYTES=5242880
LOG_KEEP_BYTES=262144

# Feed relay proxies (for RSS feeds that block this server's IP)
# Used by fetchFeedWithRelay() in server.js
PROXY_USERNAME_1=your_proxy_username_1
PROXY_PASSWORD_1=your_proxy_password_1
PROXY_USERNAME_2=your_proxy_username_2
PROXY_PASSWORD_2=your_proxy_password_2

# Eventbrite (Events module)
# Personal OAuth token ("Private token") from your Eventbrite API key page.
# Required — /api/events returns 503 without it. The token stays server-side.
EVENTBRITE_PRIVATE_TOKEN=your_eventbrite_private_token_here
EVENTBRITE_PUBLIC_TOKEN=your_eventbrite_public_token_here
EVENTBRITE_API_KEY=your_eventbrite_api_key_here
EVENTBRITE_CLIENT_SECRET=your_eventbrite_client_secret_here
# The server also accepts the same value as EVENTBRITE_PRIVATE_KEY.
# EVENTBRITE_PRIVATE_KEY=your_eventbrite_private_token_here
